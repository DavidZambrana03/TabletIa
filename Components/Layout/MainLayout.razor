@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Collections.ObjectModel
@using WhiteFlexo
@inject ModuleDataService ModuleService
@inject OpcUaClient opcUaClient
@inject ReadDTOService ReadDTO
@inject IJSRuntime JS
@inject IToastService ToastService
@inject CultureResources CultureResources

<style>
    /* Your existing CSS styles go here... */
    html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        user-select: none; /* Standard */
        -webkit-user-select: none; /* Safari */
        -ms-user-select: none; /* IE/Edge */
    }

    .sidabar {
        display: flex;
        flex-direction: column;
        justify-content: top;
        align-items: center;
        padding: 20px;
        color: white;
        width: 8vw;
        height: 100vh;
        background: #000000;
        flex: none;
        order: 0;
        flex-grow: 0;
    }

    /* New style for the clickable speed button in the sidebar */
    .sidebar-button {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 10px 14px;
        gap: 4px;
        width: 90%;
        min-height: 52px;
        background: #FFFFFF;
        color: #000000;
        border: 1px solid #A3A3A3;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.2s;
        font-size: 1.2rem;
        font-weight: 600;
        text-align: center;
    }

        .sidebar-button:hover {
            background-color: #f0f0f0;
        }

    .main_container {
        display: flex;
        flex-grow: 1;
        width: calc(100vw - 8vw); /* Account for sidebar width */
        height: 100vh;
    }

    .container, .modal-container, .container_modals {
        display: flex;
        flex-wrap: nowrap;
        width: 92vw;
        height: 90vh; /* Use full width of the parent container */
        padding: 0; /* Remove padding that may cause gaps */
        margin: 0; /* Remove any margin causing unwanted space */
    }

    .container {
        flex-direction: column;
    }

    .modal-container {
        flex-direction: row;
        align-items: flex-start;
        padding: 20px;
        gap: 16px;
        background: #F5F5F5;
    }

    .modals {
        width: 92vw;
        height: 80vh; /* Use full width of the parent container */
        padding: 0; /* Remove padding that may cause gaps */
        margin: 0; /* Remove any margin causing unwanted space */
        background: #F5F5F5;
    }

    .container_modals {
        flex-wrap: nowrap; /* Prevent wrapping */
        padding: 20px;
        gap: 16px;
        background: #F5F5F5;
    }

    .module {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        height: 100%;
        width: 100%;
        background: #FFFFFF;
        border-radius: 8px;
        margin-bottom: 16px;
        box-sizing: border-box; /* Include padding and borders in element's size */
    }

    .tension_section {
        font-family: Arial, sans-serif;
        font-size: 20px;
        padding: 20px;
        width: 100%;
    }

        .tension_section ul {
            box-sizing: border-box;
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 10px 14px;
            gap: 8px;
            width: 100%;
            height: 52px;
            background: #FFFFFF;
            border: 1px solid #A3A3A3;
            border-radius: 8px;
            flex: none;
            order: 1;
            align-self: stretch;
            flex-grow: 0;
            cursor: pointer;
        }

    .section_header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        gap: 10px;
        width: 100%;
        height: 7%;
        color: white;
        backdrop-filter: blur(6px);
        border-radius: 4px 4px 0px 0px;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
    }

    .image {
        margin-bottom: 20px;
        padding: 15px;
        align-self: center;
        border: 0px solid gray;
    }

        .image img {
            align-self: center;
        }

    .alarms_bar {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        gap: 0px;
        width: calc(100vw - 8vw); /* Exclude sidebar width */
        height: 10vh;
        background: #FFFFFF;
        border-bottom: 3px solid #000000;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
    }

    .keypad-overlay,
    .alarms-overlay,
    .exception-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .exception-box {
        background: white;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        width: 80vw;
        max-width: 800px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }

        .exception-box h3 {
            color: #D30D3A;
            margin-top: 0;
        }

    .exception-details {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-y: auto;
        white-space: pre-wrap;
        word-wrap: break-word;
        flex-grow: 1;
        font-family: monospace;
        font-size: 0.875rem;
    }

    .bell {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 12px;
        gap: 8px;
        margin: 0 auto;
        width: 72px;
        height: 56px;
        cursor: pointer;
        background: #FFFFFF;
        border-radius: 6px;
        position: absolute;
        right: 10px;
    }

    .alarms-list {
        padding: 10px;
        display: flex;
        width: 85vw;
        gap: 12px;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-behavior: smooth; /* Optional: for smoother scroll */
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
    }

        .alarms-list::-webkit-scrollbar {
            display: none; /* Chrome, Safari and Opera */
        }


    .alarm-item {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 6px 12px 6px 6px;
        gap: 12px;
        height: 45px;
        background: #FEF0C7;
        mix-blend-mode: multiply;
        border-radius: 59px;
        flex: none;
        order: 3;
        flex-grow: 0;
    }

        .alarm-item.warning {
            background: #FEF0C7;
            color: #B54708;
        }

        .alarm-item.error {
            background: #FFF0F3;
            color: #991B1B;
        }

        .alarm-item p {
            margin: 0;
            font-family: 'Inter';
            font-style: normal;
            font-weight: 500;
            font-size: 20px;
            line-height: 25px;
            flex: none;
            order: 0;
            flex-grow: 0;
        }

    .alarm-type {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 4px 12px 4px 8px;
        gap: 4px;
        height: 33px;
        background: #DC7803;
        mix-blend-mode: normal;
        border-radius: 25px;
        color: #FFFFFF;
        flex: none;
        order: 0;
        flex-grow: 0;
    }

        .alarm-type.warning {
            background: #DC7803;
        }

        .alarm-type.error {
            background: #D30D3A;
        }

        .alarm-type p {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 500;
            font-size: 20px;
            margin: 0;
            line-height: 25px;
            text-align: center;
            color: #FFFFFF;
            flex: none;
            order: 1;
            flex-grow: 0;
        }
</style>

