            case 1: return nameof(M5_HMI_TO_PLC_DTO.bGoToHome);
            case 2: return nameof(M5_HMI_TO_PLC_DTO.bStopMove);
            case 3: return nameof(M5_HMI_TO_PLC_DTO.bGoToPrint);
            case 4: return nameof(M5_HMI_TO_PLC_DTO.bStartRecirculation);
            case 5: return nameof(M5_HMI_TO_PLC_DTO.bSleeveChangeMovement);
            case 6: return nameof(M5_HMI_TO_PLC_DTO.bStopRecirculation);
            default: return nameof(M5_HMI_TO_PLC_DTO.bStopMove);
