            </div>
        </div>
    }
</div>

@code {
    private bool isEditing = false;
    private bool isSettingsOpen = false;
    private bool showSmartPrintInfo = false;
    private float valueToChange;
    private float minValue = 0f;
    private float maxValue = 0.5f; // Adjust as needed
    private string? editingDto;
    private string? editingParameter;
    private bool editingOffsets;
    private bool LateralOffsetEdited;
    private bool OffsetEdited;
    Serilog.ILogger serilog = Serilog.Log.ForContext<WhiteFlexoView>();
    private PopupConfirmation? popup;
    private WhiteFlexo.Components.Pages.AxPcFormatChangePopup? popupaxpc;

    private void ChangePCformat()
    {
        popupaxpc?.Show();
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }


    private void ToggleSmartPrintInfo()
    {
        showSmartPrintInfo = !showSmartPrintInfo;
    }
    private void CloseSmartPrintInfo()
    {
        showSmartPrintInfo = false;
    }
    void OnStartCommand(string command)
    {
        try
        {
            switch (command)
            {
                case "Clean":
                    popup?.Show("Start Cleaning Sequence", "Clean", nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartCleaningSequence));
                    break;
                case "Empty":
                    popup?.Show("Drain Doctor Blade", "Drain", nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bDrainDoctorBlade));
                    break;
                case "Start":
                    tryToStartRecirculation();
                    break;
                case "Stop":
                    popup?.Show("Stop Flexo Recirculation", "Stop", nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartProductRecirculation));
                    break;
                default:
                    serilog.Warning($"Unknown command: {command}");
                    break;
            }
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }
    void tryToStartRecirculation()
    {
        bool lowPressure = ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureMs < 2 || ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureCs < 2;
        string tagStart = nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartProductRecirculation);

        if (lowPressure)
        {
            popup?.Show(
                "Pressure is TOO LOW. Risk of ink leakage. Are you sure?",
                "Start",
                tagStart
            );
        }
        else
        {
            popup?.Show("Start Flexo Recirculation", "Start", tagStart);
        }
        // if ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureCs || ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureMs are above 0.5, show warning saying "Doctor blade pressure is above 0.5 bar. Are you sure you want to start recirculation?" with options "Yes, start recirculation" and "No, cancel". If user selects "Yes, start recirculation", start recirculation, if user selects "No, cancel", do nothing.
        //popup?.Show("Start Flexo Recirculation", "Start", nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartProductRecirculation));
    }
    void SetPosition(int type)
    {
        var posString = GetStringType(type);
        if (string.IsNullOrEmpty(posString)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + posString, true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }

    string GetPosType(int type)
    {
        switch (type)
        {
            case 0: return "Emergency";
            case 1: return "Stand By";
            case 2: return "Home";
            case 3: return "Pre Print";
            case 4: return "Print";
            case 5: return "Sleeve Change";
            case 6: return "Moving";
            case 7: return "Manual Adjust";
            case 8: return "Set Positions";
            default: return "Unknown";
        }
    }
    string GetSelfCleanState(int type)
    {
        switch (type)
        {
            case 0: return "Emergency";
            case 1: return "Stop";
            case 2: return "Product Recirculation";
            case 3: return "Filling Water";
            case 4: return "Clean Recirculation";
            case 5: return "Emptying";
            case 6: return "Sleeve extraction";
            case 7: return "Emptying product";
            case 8: return "Slow Rotation";
            default: return "Unknown";
        }
    }

    bool IsFlexoCleanEnabled()
    {
        return ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState >= 3 &&
               ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState <= 5;
    }

    bool CanStopFlexoClean()
    {
        return ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState >= 2 &&
               ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState <= 5;
    }

    void SetPlateCylinderOffset()
    {
        opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderPrintingOffset), true);
    }
    void SetPlateCylinderOffsets()
    {
        if (OffsetEdited)
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderPrintingOffset), true);
            OffsetEdited = false;
        }
        if (LateralOffsetEdited)
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderLateralPrintingOffset), true);
            LateralOffsetEdited = false;
        }
    }
    void SetPlateCylinderLateralOffset()
    {
        opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderLateralPrintingOffset), true);
    }

    void SetRegister()
    {
        try
        {
