    private void HandleJogPress(string direction)
    {
        string plcTag = MovementDTOName(direction);
        if (string.IsNullOrEmpty(plcTag)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + plcTag, true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC on jog press ({direction}): {ex.Message}");
        }

    }

    private void HandleJogRelease(string direction)
    {
        string plcTag = MovementDTOName(direction);
        if (string.IsNullOrEmpty(plcTag)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + plcTag, false);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC on jog release ({direction}): {ex.Message}");
        }
    }

