    private int GetTorqueBar(float torque)
    {
        if (!opcUaClient.IsConnected)
        {
            return 50;
        }
        else
        {
            int percent = (int)torque ;
            return percent;
        }
    }

    private string GetTorqueColor(float torque)
    {
        if (!opcUaClient.IsConnected)
        {
            return "#4CD964";
        }
        else
        {
            return torque switch
            {
                > 80 => "#FF3B30", // Rojo: Crítico, motor sufriendo
                > 50 => "#FFCC00", // Amarillo/Naranja: Esfuerzo elevado
                _ => "#4CD964"  // Verde: Todo OK, movimiento fluido
            };
        }
    }
    private string GetStringMovement(int type)
    {
        switch (type)
