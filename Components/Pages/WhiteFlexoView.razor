    void ChangeParameter(string dto, string parameter)
    {
        editingDto = dto;
        editingParameter = parameter;

        object param = opcUaClient.ReadFromPlc($"{dto}.{parameter}");

        if (float.TryParse(param?.ToString(), out float parsedVal))
        {
            valueToChange = parsedVal;
        }
        else
        {
            valueToChange = 0f;
        }
        SetMinMax(dto, parameter);
        isEditing = true;
        if (parameter == "rPlateCylinderPrintingOffset" || parameter == "rPlateCylinderPrintingOffset")
        {
            editingOffsets = true;
        }
        if (parameter == "rMarkSensorPositionSetpoint")
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartMarkSensor), true);
        }

    }
    private void SetMinMax(string dto, string paramName)
    {
        minValue = 0.0f; // Default min value
        maxValue = 100.0f; // Default max value
        switch (dto)
        {
            case nameof(M0_HMI_TO_PLC_DTO):
                ReadDTO.M0_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M1_HMI_TO_PLC_DTO):
                ReadDTO.M1_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M2_HMI_TO_PLC_DTO):
                ReadDTO.M2_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M4_HMI_TO_PLC_DTO):
                ReadDTO.M4_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, ref minValue, ref maxValue);
                break;
            case nameof(M5_HMI_TO_PLC_DTO):
                ReadDTO.M5_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M7_HMI_TO_PLC_DTO):
                ReadDTO.M7_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            default:
                break;
        }
    }
    private void CancelEdit()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void CloseKeypad()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void SaveValue(object value)
    {
        if (editingDto != null && editingParameter != null)
        {
            opcUaClient.WriteToPlc(editingDto + "." + editingParameter, value);
            if (editingParameter.Equals(nameof(M5_HMI_TO_PLC_DTO.rDrBladePressureCs)))
            {
                opcUaClient.WriteToPlc(editingDto + "." + nameof(M5_HMI_TO_PLC_DTO.rDrBladePressureMs), value);
            }
        }
        isEditing = false;
        if (editingOffsets)
        {
            object param = opcUaClient.ReadFromPlc(editingDto + "." + editingParameter);
            if (param != value)
            {
                if (editingParameter.Equals("rPlateCylinderPrintingLateralOffset"))
                {
                    LateralOffsetEdited = true;
                }
                else if (editingParameter.Equals("rPlateCylinderPrintingOffset"))
                {
                    OffsetEdited = true;
                }
            }
        };
    }

