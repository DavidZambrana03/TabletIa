    string MovementDTOName(string movement)
    {
        switch (movement)
        {
            case "UpMS": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd_MS);
            case "DownMS": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev_MS);
            case "UpCS": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd_CS);
            case "DownCS": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev_CS);
            case "Up": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd);
            case "Down": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev);
            case "MS": return nameof(M5_HMI_TO_PLC_DTO.bDeckMoveTo_MS);
            case "CS": return nameof(M5_HMI_TO_PLC_DTO.bDeckMoveTo_CS);
            case "WINDOW": return nameof(M5_HMI_TO_PLC_DTO.bFlexoMarkSensorWindowPb);
            case "TEACH": return nameof(M5_HMI_TO_PLC_DTO.bFlexoMarkSensorTeach);
            default: return string.Empty;
        }
    }

    string GetImageClass(string imageName)
