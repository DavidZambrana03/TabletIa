                <ul @onclick="() => ChangeParameter(nameof(M5_HMI_TO_PLC_DTO), nameof(M5_HMI_TO_PLC_DTO.iPumpSpeedSP))">
                    @(ReadDTO.M5_HMI_TO_PLC_DTO.iPumpSpeedSP) %
