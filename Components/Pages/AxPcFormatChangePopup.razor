@page "/pages/AxPcFormatChangePopup"
@inject ReadDTOService ReadDTO
@inject OpcUaClient opcUaClient
@*
    It's highly recommended to move these styles to a dedicated CSS isolation file
    named "AxPcFormatChangePopup.razor.css". This encapsulates the styles, preventing
    them from affecting other components in your application.
*@
<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000; /* Ensure it appears on top of other content */
    }

    .popup-box {
        width: 600px;
        max-width: 95%; /* Ensures responsiveness on smaller screens */
        height: auto; /* Auto height to fit content */
        background-color: white;
        padding: 1.5rem;
        border-radius: 1rem;
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        gap: 1.5rem; /* Provides consistent spacing between sections */
    }

    .popup-box__header {
        font-size: 1.25rem; /* text-xl */
        font-weight: 700; /* font-bold */
        color: #111827; /* gray-900 */
    }

    .popup-box__section {
        font-family: 'Inter', sans-serif;
    }

    .popup-box__section-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #374151; /* gray-700 */
    }

    .popup-box__value-display {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        padding: 12px 14px;
        width: 100%;
        min-height: 52px;
        background: #FFFFFF;
        border: 1px solid #A3A3A3;
        border-radius: 8px;
        font-size: 1.125rem;
        cursor: pointer;
        transition: background-color 0.2s, border-color 0.2s;
    }

        .popup-box__value-display:hover {
            background-color: #f9fafb; /* gray-50 */
            border-color: #6B7280; /* gray-500 */
        }

    .popup-box__actions {
        display: flex;
        justify-content: center;
        margin-top: 1rem;
    }

    .popup-box__button {
        min-width: 120px;
        height: 44px;
        padding: 0 1.5rem;
        background-color: #1f2937; /* gray-800 */
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-size: 1.125rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .popup-box__button:hover {
            background-color: #374151; /* gray-700 */
        }

    .keypad-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); /* Darker overlay to focus on keypad */
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1010; /* Ensure keypad is on top of the popup */
    }
</style>

@if (IsVisible)
{
    <div class="popup-overlay">
        <div class="popup-box">
            <h3 class="popup-box__header">Sleeve change, please enter format</h3>

            <div class="popup-box__section">
                <h4 class="popup-box__section-title">PC Format</h4>
                <div class="popup-box__value-display" @onclick="() => EditValue(nameof(M5_HMI_TO_PLC_DTO), nameof(M5_HMI_TO_PLC_DTO.rPcFormat))">
                    @Math.Round(ReadDTO.M5_HMI_TO_PLC_DTO.rPcFormat, 2) mm
                </div>
            </div>

           @*  <div class="popup-box__section">
                <h4 class="popup-box__section-title">AX Format</h4>
                <div class="popup-box__value-display" @onclick="() => EditValue(nameof(M5_HMI_TO_PLC_DTO), nameof(M5_HMI_TO_PLC_DTO.rAniloxFormat))">
                    @Math.Round(ReadDTO.M5_HMI_TO_PLC_DTO.rAniloxFormat, 2) mm
                </div>
            </div> *@

            <div class="popup-box__actions">
                <button class="popup-box__button" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@if (isEditing)
{
    @* Clicks on the overlay will close the keypad without saving *@
    <div class="keypad-overlay" @onclick="CancelEdit">
        @* Add stop propagation to the Keypad component's container to prevent the overlay's onclick from firing when clicking on the keypad itself *@
        <div @onclick:stopPropagation="true">
            <Keypad Value="@valueToChange" MinValue="@minValue" MaxValue="@maxValue" OnSave="SaveValue" OnCancel="CancelEdit" />
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<int> OnConfirmed { get; set; }

    private bool isEditing = false;
    public bool IsVisible { get; private set; } = false;
    private float minValue = 0f;
    private float maxValue = 0.5f; // Adjust as needed
    private float valueToChange;
    private string? editingDto;
    private string? editingParameter;

    /// <summary>
    /// Displays the popup. This is the public method to be called by a parent component.
    /// </summary>
    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }
    private void SetMinMax(string dto, string paramName)
    {
        minValue = 0.0f; // Default min value
        maxValue = 100.0f; // Default max value
        switch (dto)
        {
            case nameof(M0_HMI_TO_PLC_DTO):
                ReadDTO.M0_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M1_HMI_TO_PLC_DTO):
                ReadDTO.M1_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M2_HMI_TO_PLC_DTO):
                ReadDTO.M2_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M4_HMI_TO_PLC_DTO):
                ReadDTO.M4_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, ref minValue, ref maxValue);
                break;
            case nameof(M5_HMI_TO_PLC_DTO):
                ReadDTO.M5_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M7_HMI_TO_PLC_DTO):
                ReadDTO.M7_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            default:
                break;
        }
    }
    /// <summary>
    /// Prepares to edit a value. Reads the current value from the PLC and shows the keypad.
    /// Using async Task for better async practice, even if the current read operation is synchronous.
    /// </summary>
    private Task EditValue(string dto, string parameter)
    {
        editingDto = dto;
        editingParameter = parameter;
        try
        {
            var param = opcUaClient.ReadFromPlc($"{dto}.{parameter}");
            if (param != null)
            {
                // Using Convert.ToSingle for safer type conversion from object.
                valueToChange = Convert.ToSingle(param);
            }
            SetMinMax(dto, parameter);
            isEditing = true;
        }
        catch (Exception ex)
        {
            // Log the error. In a real application, you might show a notification to the user.
            Console.WriteLine($"Error reading value from PLC: {ex.Message}");
        }

        // Let Blazor handle the re-render automatically.
        return Task.CompletedTask;
    }

    /// <summary>
    /// Saves the new value from the keypad to the PLC.
    /// Changed from async void to async Task to handle exceptions and async operations correctly.
    /// </summary>
    private async Task SaveValue(object value)
    {
        if (!string.IsNullOrEmpty(editingDto) && !string.IsNullOrEmpty(editingParameter))
        {
            try
            {
                // If your client has an async version (e.g., WriteToPlcAsync), it should be awaited here.
                opcUaClient.WriteToPlc($"{editingDto}.{editingParameter}", value);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error writing value to PLC: {ex.Message}");
                // Optionally, notify the user that the save failed.
            }
        }
        isEditing = false;
        // The UI will be re-rendered automatically by Blazor after the await completes.
        // We call StateHasChanged here because the change happens within a callback from a child.
        StateHasChanged();
    }

    /// <summary>
    /// Hides the keypad without saving the value.
    /// </summary>
    private void CancelEdit()
    {
        isEditing = false;
        StateHasChanged();
    }

    /// <summary>
    /// Closes the main popup and notifies the parent component.
    /// Changed from async void to async Task.
    /// </summary>
    private async Task Close()
    {
        IsVisible = false;
        await OnConfirmed.InvokeAsync(0);
    }
}
