@page "/pages/RewinderView"
@inject ReadDTOService ReadDTO
@inject OpcUaClient opcUaClient
@inject IJSRuntime JS
@using Serilog
@using WhiteFlexo

<style>
    .module_big {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: white;
        width: 100%;
        height: 100%;
        border-radius: 8px;
        transition: transform 1s ease;
        font-family: 'Inter', sans-serif;
    }
    .section_header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        gap: 10px;
        width: 100%;
        height: 39px;
        color: white;
        backdrop-filter: blur(6px);
        border-radius: 4px 4px 0px 0px;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
    }
    .status {
        height: 23px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #141414;
        flex: none;
        order: 1;
        flex-grow: 0;
    }
    .status-text {
        color: white;
    }
    .toggle-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        padding: 10px;
    }
    .toggle-buttons button {
        padding: 10px 20px;
        font-size: 1.2em;
        border: none;
        background: none;
        color: black;
        cursor: pointer;
        transition: border-bottom 0s, color 0.3s;
    }
    .toggle-buttons button.active {
        border-bottom: 3px solid black;
        color: black;
    }
    .main_view {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100%;
        margin: 10px;
        gap: 10px;
    }
    .left-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
        background: #F5F5F5;
        height: 100%;
        border-radius: 15px;
        align-items: flex-start;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }
    .right-container {
        display: flex;
        flex-direction: column;
        gap: 60px;
        padding: 20px;
        background: #F5F5F5;
        border-radius: 15px;
        height: 100%;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }
    .config_parameter {
        display: flex;
        flex-direction: column;
        padding: 0px;
        gap: 6px;
        width: 250px;
        height: 110px;
    }
    .config_parameter h4 {
        width: 250px;
        height: 23px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-size: 18px;
        line-height: 23px;
        color: #424242;
        flex: none;
        order: 0;
        flex-grow: 0;
    }
    .config_parameter ul {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10px 14px;
        gap: 8px;
        width: 250px;
        height: 52px;
        background: #FFFFFF;
        border: 1px solid #A3A3A3;
        border-radius: 8px;
        flex: none;
        order: 1;
        align-self: stretch;
        flex-grow: 0;
    }
    .config_parameters_container {
        display: grid;
        margin-top: 1.5rem;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }
    .button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #FFFFFF;
        border: 2px solid #000000;
        border-radius: 8px;
        flex: none;
        order: 0;
        flex-grow: 0;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #000000;
        cursor: pointer;
    }
    .button:active {
        background: #e0e0e0;
        transform: translateY(2px);
        box-shadow: inset 0px 2px 4px rgba(0, 0, 0, 0.2);
    }
    .navigation-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        gap: 20px;
    }
    .start-button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #000000;
        border: 1px solid #000000;
        border-radius: 8px;
        color: white;
        flex: none;
        order: 2;
        flex-grow: 0;
    }
    .toggle-switch {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }
    .switch {
        width: 50px;
        height: 28px;
        background-color: #ccc;
        border-radius: 999px;
        position: relative;
        transition: background-color 0.3s ease;
        margin-right: 10px;
    }
    .switch::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 24px;
        height: 24px;
        background-color: white;
        border-radius: 50%;
        transition: transform 0.3s ease;
    }
    .switch.enabled {
        background-color: #000;
    }
    .switch.enabled::before {
        transform: translateX(22px);
    }
    .side-indicator {
        font-size: 13px;
        color: #A3A3A3;
        font-weight: 400;
        display: block;
        width: 180px;
        text-align: left;
        margin-bottom: 2px;
        margin-top: -2px;
    }
    .text-left-aligned {
        text-align: left !important;
        width: 100%;
        padding-left: 2px;
        display: block;
        margin-bottom: 2px !important;
    }
</style>

<div class="module_big" style="@GetModuleStyle(ModuleStatus)">
    <div class="section_header" style="@GetStatusStyle(ModuleStatus)">
        <div class="status">
            <span class="status-text">Rewinder</span>
        </div>
        <div class="status">
            <span class="status-text">@ModuleStatus</span>
        </div>
    </div>
    <div class="toggle-buttons">
        <button class="round-buttons" @onclick="Close">
            <svg width="18" height="13" viewBox="0 0 13 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(90deg);">
                <path d="M1.90039 1.49988L6.90039 6.49988L11.9004 1.49988" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button class="@GetButtonClass("Rewinder")" @onclick='() => SelectMode("Rewinder")'>Rewinder</button>
        <button class="@GetButtonClass("Taper")" @onclick='() => SelectMode("Taper")'>Taper</button>
        <button class="@GetButtonClass("Configuration")" @onclick='() => SelectMode("Configuration")'>Configuration</button>
    </div>

    @if (selectedMode == "Rewinder")
    {
        <div class="main_view">
            <div class="left-container">
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Tension</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rRewTensionSP))">
                            @Math.Round(ReadDTO.M7_PLC_TO_HMI_DTO.rRewTensionPV, 1) Kg
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Diameter</h4>
                        <ul>@Math.Round(ReadDTO.M7_PLC_TO_HMI_DTO.rRewDiameterPV, 1) mm</ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Lay-on pressure</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rLayonPressureSP))">
                            @Math.Round(ReadDTO.M7_PLC_TO_HMI_DTO.rLayonPressurePV, 1) bar
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Core size</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rRewCoreSize))">
                            @ReadDTO.M7_PLC_TO_HMI_DTO.rRewCoreSize mm
                        </ul>
                    </div>
                </div>
                <div style="text-align: center; width: 100%; margin: 10px 0px;">
                    <img src="resources/M7.jpg" style="width: 200px; display: inline-block;" />
                </div>
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Dancer</h4>
                        <ul>@ReadDTO.M7_PLC_TO_HMI_DTO.iRewDancerPercentage %</ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Dancer status</h4>
                        <ul>
                            @if (ReadDTO.M7_PLC_TO_HMI_DTO.bRewDancerCalibrated)
                            {
                                <span>Calibrated</span>
                            }
                            else if (ReadDTO.M7_PLC_TO_HMI_DTO.bRewDancerNotCalibrated)
                            {
                                <span>Not calibrated</span>
                            }
                            else
                            {
                                <span>Unknown</span>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="right-container">
                <div class="navigation-buttons">
                    @if (!ReadDTO.M7_PLC_TO_HMI_DTO.bRewDancerCalibrated)
                    {
                        <button class="button start-button" @onclick='() => CalibrateDancer()'>Calibrate Dancer</button>
                    }
                </div>
                <div class="navigation-buttons">
                    <div class="toggle-switch" @onclick="ToggleDirection">
                        <div class="switch @(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDirection ? "enabled" : "")"></div>
                        <span>@(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDirection ? "Fwd" : "Rev")</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (selectedMode == "Taper")
    {
        <div class="main_view">
            <div class="left-container">
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Taper tension</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rTaperTensionSP))">
                            @Math.Round(ReadDTO.M7_PLC_TO_HMI_DTO.rTaperTensionPV, 1)
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Taper pressure</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rTaperPressureSP))">
                            @Math.Round(ReadDTO.M7_PLC_TO_HMI_DTO.rTaperPressurePV, 1) bar
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Diameter offset</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rDiameterOffsetTaperSP))">
                            @ReadDTO.M7_PLC_TO_HMI_DTO.rDiameterOffsetTaperPV
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Taper type</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.iTaperType))">
                            @GetTaperType(ReadDTO.M7_PLC_TO_HMI_DTO.iTapperType)
                        </ul>
                    </div>
                </div>
            </div>
            <div class="right-container">
                <img src="resources/M7.jpg" style="width: 250px; display: inline-block;" />
            </div>
        </div>
    }

    @if (selectedMode == "Configuration")
    {
        <div class="config_parameters_container">
            <div class="config_parameter">
                <h4>Meter stop setpoint</h4>
                <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rRewMeterStopSP))">
                    @ReadDTO.M7_PLC_TO_HMI_DTO.rRewMeterStopPV
                </ul>
            </div>
            <div class="config_parameter">
                <h4>Diameter stop setpoint</h4>
                <ul @onclick="() => ChangeParameter(nameof(M7_HMI_TO_PLC_DTO), nameof(M7_HMI_TO_PLC_DTO.rRewDiameterStopSP))">
                    @ReadDTO.M7_PLC_TO_HMI_DTO.rRewDiameterStopPV mm
                </ul>
            </div>
            <div class="config_parameter">
                <h4>Meter stop</h4>
                <div class="toggle-switch" @onclick="ToggleMeterStop">
                    <div class="switch @(ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterStop ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterStop ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Diameter stop</h4>
                <div class="toggle-switch" @onclick="ToggleDiameterStop">
                    <div class="switch @(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterStop ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterStop ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Meter acoustic signal</h4>
                <div class="toggle-switch" @onclick="ToggleMeterAcousticSignal">
                    <div class="switch @(ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterAcusticSignal ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterAcusticSignal ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Diameter acoustic signal</h4>
                <div class="toggle-switch" @onclick="ToggleDiameterAcousticSignal">
                    <div class="switch @(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterAcusticSignal ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterAcusticSignal ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Set min diameter</h4>
                <button class="button" @onclick='() => SetMinDiameter()'>Set min</button>
            </div>
            <div class="config_parameter">
                <h4>Set max diameter</h4>
                <button class="button" @onclick='() => SetMaxDiameter()'>Set max</button>
            </div>
        </div>
    }

    <PopupConfirmation @ref="popup" />
    @if (isEditing)
    {
        <div class="keypad-overlay" @onclick="CloseKeypad">
            <div @onclick:stopPropagation="true">
                <Keypad Value="@valueToChange" MinValue="@minValue" MaxValue="@maxValue" OnSave="SaveValue" OnCancel="CancelEdit" />
            </div>
        </div>
    }
</div>

@code {
    private bool isEditing = false;
    private float valueToChange;
    private float minValue = 0f;
    private float maxValue = 0.5f;
    private string? editingDto;
    private string? editingParameter;
    private PopupConfirmation? popup;
    Serilog.ILogger serilog = Serilog.Log.ForContext<RewinderView>();

    [Parameter] public EventCallback OnClose { get; set; }

    private string selectedMode = "Rewinder";

    private string ModuleStatus
    {
        get
        {
            if (ReadDTO.M7_PLC_TO_HMI_DTO.bRewDancerCalibrationFail) return "Calibration Fail";
            if (ReadDTO.M7_PLC_TO_HMI_DTO.bRewDancerNotCalibrated) return "Not Calibrated";
            return "Ready";
        }
    }

    private void SelectMode(string mode)
    {
        selectedMode = mode;
    }

    private string GetButtonClass(string mode)
    {
        return selectedMode == mode ? "active" : "";
    }

    private string GetTaperType(int type)
    {
        return type switch
        {
            0 => "None",
            1 => "Tension",
            2 => "Pressure",
            3 => "Torque",
            _ => "Unknown"
        };
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private void ToggleDirection()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewinderTurnDirection), !ReadDTO.M7_PLC_TO_HMI_DTO.bRewDirection);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling direction: {ex.Message}");
        }
    }

    private void ToggleMeterStop()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewMeterStop), !ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterStop);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling meter stop: {ex.Message}");
        }
    }

    private void ToggleDiameterStop()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewDiameterStop), !ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterStop);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling diameter stop: {ex.Message}");
        }
    }

    private void ToggleMeterAcousticSignal()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewMeterAcusticSignal), !ReadDTO.M7_PLC_TO_HMI_DTO.bRewMeterAcusticSignal);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling meter acoustic signal: {ex.Message}");
        }
    }

    private void ToggleDiameterAcousticSignal()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewDiameterAcusticSignal), !ReadDTO.M7_PLC_TO_HMI_DTO.bRewDiameterAcusticSignal);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling diameter acoustic signal: {ex.Message}");
        }
    }

    private void CalibrateDancer()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewDancerCalibrationStart), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error calibrating dancer: {ex.Message}");
        }
    }

    private void SetMinDiameter()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewSetMinDiameter), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error setting min diameter: {ex.Message}");
        }
    }

    private void SetMaxDiameter()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M7_HMI_TO_PLC_DTO) + "." + nameof(M7_HMI_TO_PLC_DTO.bRewSetMaxDiameter), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error setting max diameter: {ex.Message}");
        }
    }

    void ChangeParameter(string dto, string parameter)
    {
        editingDto = dto;
        editingParameter = parameter;

        object param = opcUaClient.ReadFromPlc($"{dto}.{parameter}");

        if (float.TryParse(param?.ToString(), out float parsedVal))
        {
            valueToChange = parsedVal;
        }
        else
        {
            valueToChange = 0f;
        }
        SetMinMax(dto, parameter);
        isEditing = true;
    }

    private void SetMinMax(string dto, string paramName)
    {
        minValue = 0.0f;
        maxValue = 100.0f;
        switch (dto)
        {
            case nameof(M7_HMI_TO_PLC_DTO):
                ReadDTO.M7_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
        }
    }

    private void SaveValue(object value)
    {
        if (editingDto != null && editingParameter != null)
        {
            opcUaClient.WriteToPlc(editingDto + "." + editingParameter, value);
        }
        isEditing = false;
    }

    private void CancelEdit()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void CloseKeypad()
    {
        isEditing = false;
        StateHasChanged();
    }

    private string GetModuleStyle(string status)
    {
        return status switch
        {
            "Ready" => "border: 3px solid #039855;",
            "Not Calibrated" => "border: 3px solid #DC6803;",
            "Calibration Fail" => "border: 3px solid #D30D3A; background: #ffcccc;",
            _ => "border: 3px solid #039855;"
        };
    }

    private string GetStatusStyle(string status)
    {
        return status switch
        {
            "Ready" => "border: 3px solid #039855; background: #039855",
            "Not Calibrated" => "border: 3px solid #DC6803; background: #DC6803",
            "Calibration Fail" => "border: 3px solid #D30D3A; background: #D30D3A;",
            _ => "border: 3px solid #039855; background: #039855"
        };
    }
}
