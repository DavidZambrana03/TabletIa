@page "/pages/UnwinderView"
@inject ReadDTOService ReadDTO
@inject OpcUaClient opcUaClient
@inject IJSRuntime JS
@using Serilog
@using WhiteFlexo

<style>
    .module_big {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: white;
        width: 100%;
        height: 100%;
        border-radius: 8px;
        transition: transform 1s ease;
        font-family: 'Inter', sans-serif;
    }
    .section_header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        gap: 10px;
        width: 100%;
        height: 39px;
        color: white;
        backdrop-filter: blur(6px);
        border-radius: 4px 4px 0px 0px;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
    }
    .status {
        height: 23px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #141414;
        flex: none;
        order: 1;
        flex-grow: 0;
    }
    .status-text {
        color: white;
    }
    .toggle-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        padding: 10px;
    }
    .toggle-buttons button {
        padding: 10px 20px;
        font-size: 1.2em;
        border: none;
        background: none;
        color: black;
        cursor: pointer;
        transition: border-bottom 0s, color 0.3s;
    }
    .toggle-buttons button.active {
        border-bottom: 3px solid black;
        color: black;
    }
    .main_view {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100%;
        margin: 10px;
        gap: 10px;
    }
    .left-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
        background: #F5F5F5;
        height: 100%;
        border-radius: 15px;
        align-items: flex-start;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }
    .right-container {
        display: flex;
        flex-direction: column;
        gap: 60px;
        padding: 20px;
        background: #F5F5F5;
        border-radius: 15px;
        height: 100%;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }
    .config_parameter {
        display: flex;
        flex-direction: column;
        padding: 0px;
        gap: 6px;
        width: 250px;
        height: 110px;
    }
    .config_parameter h4 {
        width: 250px;
        height: 23px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-size: 18px;
        line-height: 23px;
        color: #424242;
        flex: none;
        order: 0;
        flex-grow: 0;
    }
    .config_parameter ul {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10px 14px;
        gap: 8px;
        width: 250px;
        height: 52px;
        background: #FFFFFF;
        border: 1px solid #A3A3A3;
        border-radius: 8px;
        flex: none;
        order: 1;
        align-self: stretch;
        flex-grow: 0;
    }
    .config_parameters_container {
        display: grid;
        margin-top: 1.5rem;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }
    .button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #FFFFFF;
        border: 2px solid #000000;
        border-radius: 8px;
        flex: none;
        order: 0;
        flex-grow: 0;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #000000;
        cursor: pointer;
    }
    .button:active {
        background: #e0e0e0;
        transform: translateY(2px);
        box-shadow: inset 0px 2px 4px rgba(0, 0, 0, 0.2);
    }
    .navigation-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        gap: 20px;
    }
    .start-button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #000000;
        border: 1px solid #000000;
        border-radius: 8px;
        color: white;
        flex: none;
        order: 2;
        flex-grow: 0;
    }
    .toggle-switch {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }
    .switch {
        width: 50px;
        height: 28px;
        background-color: #ccc;
        border-radius: 999px;
        position: relative;
        transition: background-color 0.3s ease;
        margin-right: 10px;
    }
    .switch::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 24px;
        height: 24px;
        background-color: white;
        border-radius: 50%;
        transition: transform 0.3s ease;
    }
    .switch.enabled {
        background-color: #000;
    }
    .switch.enabled::before {
        transform: translateX(22px);
    }
    .side-by-side {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 0px;
        width: 100%;
    }
    .padding_section {
        padding: 20px;
        justify-content: center;
    }
</style>

<div class="module_big" style="@GetModuleStyle(ModuleStatus)">
    <div class="section_header" style="@GetStatusStyle(ModuleStatus)">
        <div class="status">
            <span class="status-text">Unwinder</span>
        </div>
        <div class="status">
            <span class="status-text">@ModuleStatus</span>
        </div>
    </div>
    <div class="toggle-buttons">
        <button class="round-buttons" @onclick="Close">
            <svg width="18" height="13" viewBox="0 0 13 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(90deg);">
                <path d="M1.90039 1.49988L6.90039 6.49988L11.9004 1.49988" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button class="@GetButtonClass("Unwinder")" @onclick='() => SelectMode("Unwinder")'>Unwinder</button>
        <button class="@GetButtonClass("Treater")" @onclick='() => SelectMode("Treater")'>Treater</button>
        <button class="@GetButtonClass("Configuration")" @onclick='() => SelectMode("Configuration")'>Configuration</button>
    </div>

    @if (selectedMode == "Unwinder")
    {
        <div class="main_view">
            <div class="left-container">
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Tension</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rUnwTensionSP))">
                            @Math.Round(ReadDTO.M1_PLC_TO_HMI_DTO.rUnwTensionPV, 1) Kg
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Diameter</h4>
                        <ul>@Math.Round(ReadDTO.M1_PLC_TO_HMI_DTO.rUnwDiameterPV, 1) mm</ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Material width</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rMaterialWidthSP))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rMaterialWidth mm
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Material thickness</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rMaterialThicknessSP))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rMaterialThicknessPV mm
                        </ul>
                    </div>
                </div>
                <div style="text-align: center; width: 100%; margin: 10px 0px;">
                    <img src="resources/M1.jpg" style="width: 200px; display: inline-block;" />
                </div>
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Core size</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rUnwCoreSize))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rUnwCoreSize mm
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Dancer</h4>
                        <ul>@ReadDTO.M1_PLC_TO_HMI_DTO.iDancerActualPercentage %</ul>
                    </div>
                </div>
            </div>
            <div class="right-container">
                <div class="navigation-buttons">
                    <div class="config_parameter">
                        <h4>Splice detector</h4>
                        <ul>@(ReadDTO.M1_PLC_TO_HMI_DTO.bSpliceDetectorOk ? "OK" : "Not OK")</ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Splice in progress</h4>
                        <ul>@(ReadDTO.M1_PLC_TO_HMI_DTO.bSpliceInProgress ? "Yes" : "No")</ul>
                    </div>
                </div>
                <div class="navigation-buttons">
                    @if (!ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDancerCalibrated)
                    {
                        <button class="button start-button" @onclick='() => CalibrateDancer()'>Calibrate Dancer</button>
                    }
                    else
                    {
                        <div class="config_parameter">
                            <h4>Dancer status</h4>
                            <ul>Calibrated</ul>
                        </div>
                    }
                </div>
                <div class="navigation-buttons">
                    <div class="toggle-switch" @onclick="ToggleDirection">
                        <div class="switch @(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDirection ? "enabled" : "")"></div>
                        <span>@(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDirection ? "Fwd" : "Rev")</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (selectedMode == "Treater")
    {
        <div class="main_view">
            <div class="left-container">
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4>Power</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterPowerSP))">
                            @Math.Round(ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterPowerPV, 1) W
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Dose</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterDoseSP))">
                            @Math.Round(ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterDosePV, 1)
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Min power</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterPropMinPower))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterPropMinPower W
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Max power</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterPropMaxPower))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterPropMaxPower W
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Min speed</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterPropMinSpeed))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterPorpMinSpeed m/min
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4>Max speed</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rTreaterPropMaxSpeed))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.rTreaterPropMaxSpeed m/min
                        </ul>
                    </div>
                </div>
            </div>
            <div class="right-container">
                <div class="navigation-buttons">
                    <div class="toggle-switch" @onclick="ToggleTreater">
                        <div class="switch @(ReadDTO.M1_PLC_TO_HMI_DTO.bTreaterEnabled ? "enabled" : "")"></div>
                        <span>@(ReadDTO.M1_PLC_TO_HMI_DTO.bTreaterEnabled ? "Enabled" : "Disabled")</span>
                    </div>
                </div>
                <div class="navigation-buttons">
                    <div class="config_parameter" style="width: 200px;">
                        <h4>Mode</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.iTreaterWorkMode))">
                            @GetTreaterMode(ReadDTO.M1_PLC_TO_HMI_DTO.iTreaterMode)
                        </ul>
                    </div>
                </div>
                <div class="navigation-buttons">
                    <div class="config_parameter" style="width: 200px;">
                        <h4>Material type</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.iMaterialType))">
                            @ReadDTO.M1_PLC_TO_HMI_DTO.iMaterialType
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (selectedMode == "Configuration")
    {
        <div class="config_parameters_container">
            <div class="config_parameter">
                <h4>Diameter stop</h4>
                <ul @onclick="() => ChangeParameter(nameof(M1_HMI_TO_PLC_DTO), nameof(M1_HMI_TO_PLC_DTO.rUnwDiameterStopSP))">
                    @ReadDTO.M1_PLC_TO_HMI_DTO.rUnwDiameterStopPV mm
                </ul>
            </div>
            <div class="config_parameter">
                <h4>Diameter stop enable</h4>
                <div class="toggle-switch" @onclick="ToggleDiameterStop">
                    <div class="switch @(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterStop ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterStop ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Acoustic signal</h4>
                <div class="toggle-switch" @onclick="ToggleAcousticSignal">
                    <div class="switch @(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterAcusticSignal ? "enabled" : "")"></div>
                    <span>@(ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterAcusticSignal ? "On" : "Off")</span>
                </div>
            </div>
            <div class="config_parameter">
                <h4>Set min diameter</h4>
                <button class="button" @onclick='() => SetMinDiameter()'>Set min</button>
            </div>
            <div class="config_parameter">
                <h4>Set max diameter</h4>
                <button class="button" @onclick='() => SetMaxDiameter()'>Set max</button>
            </div>
        </div>
    }

    <PopupConfirmation @ref="popup" />
    @if (isEditing)
    {
        <div class="keypad-overlay" @onclick="CloseKeypad">
            <div @onclick:stopPropagation="true">
                <Keypad Value="@valueToChange" MinValue="@minValue" MaxValue="@maxValue" OnSave="SaveValue" OnCancel="CancelEdit" />
            </div>
        </div>
    }
</div>

@code {
    private bool isEditing = false;
    private float valueToChange;
    private float minValue = 0f;
    private float maxValue = 0.5f;
    private string? editingDto;
    private string? editingParameter;
    private PopupConfirmation? popup;
    Serilog.ILogger serilog = Serilog.Log.ForContext<UnwinderView>();

    [Parameter] public EventCallback OnClose { get; set; }

    private string selectedMode = "Unwinder";

    private string ModuleStatus
    {
        get
        {
            if (ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDancerCalibrationFail) return "Calibration Fail";
            if (ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDancerNotCalibrated) return "Not Calibrated";
            return "Ready";
        }
    }

    private void SelectMode(string mode)
    {
        selectedMode = mode;
    }

    private string GetButtonClass(string mode)
    {
        return selectedMode == mode ? "active" : "";
    }

    private string GetTreaterMode(int mode)
    {
        return mode switch
        {
            0 => "Off",
            1 => "Auto",
            2 => "Manual",
            _ => "Unknown"
        };
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private void ToggleDirection()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwTurnDirection), !ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDirection);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling direction: {ex.Message}");
        }
    }

    private void ToggleTreater()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bEnableTreater), !ReadDTO.M1_PLC_TO_HMI_DTO.bTreaterEnabled);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling treater: {ex.Message}");
        }
    }

    private void ToggleDiameterStop()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwDiameterStop), !ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterStop);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling diameter stop: {ex.Message}");
        }
    }

    private void ToggleAcousticSignal()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwDiameterAcusticsignal), !ReadDTO.M1_PLC_TO_HMI_DTO.bUnwDiameterAcusticSignal);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error toggling acoustic signal: {ex.Message}");
        }
    }

    private void CalibrateDancer()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwDancerCalibrationStart), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error calibrating dancer: {ex.Message}");
        }
    }

    private void SetMinDiameter()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwSetMinDiameter), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error setting min diameter: {ex.Message}");
        }
    }

    private void SetMaxDiameter()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M1_HMI_TO_PLC_DTO) + "." + nameof(M1_HMI_TO_PLC_DTO.bUnwSetMaxDiameter), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error setting max diameter: {ex.Message}");
        }
    }

    void ChangeParameter(string dto, string parameter)
    {
        editingDto = dto;
        editingParameter = parameter;

        object param = opcUaClient.ReadFromPlc($"{dto}.{parameter}");

        if (float.TryParse(param?.ToString(), out float parsedVal))
        {
            valueToChange = parsedVal;
        }
        else
        {
            valueToChange = 0f;
        }
        SetMinMax(dto, parameter);
        isEditing = true;
    }

    private void SetMinMax(string dto, string paramName)
    {
        minValue = 0.0f;
        maxValue = 100.0f;
        switch (dto)
        {
            case nameof(M1_HMI_TO_PLC_DTO):
                ReadDTO.M1_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
        }
    }

    private void SaveValue(object value)
    {
        if (editingDto != null && editingParameter != null)
        {
            opcUaClient.WriteToPlc(editingDto + "." + editingParameter, value);
        }
        isEditing = false;
    }

    private void CancelEdit()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void CloseKeypad()
    {
        isEditing = false;
        StateHasChanged();
    }

    private string GetModuleStyle(string status)
    {
        return status switch
        {
            "Ready" => "border: 3px solid #039855;",
            "Not Calibrated" => "border: 3px solid #DC6803;",
            "Calibration Fail" => "border: 3px solid #D30D3A; background: #ffcccc;",
            _ => "border: 3px solid #039855;"
        };
    }

    private string GetStatusStyle(string status)
    {
        return status switch
        {
            "Ready" => "border: 3px solid #039855; background: #039855",
            "Not Calibrated" => "border: 3px solid #DC6803; background: #DC6803",
            "Calibration Fail" => "border: 3px solid #D30D3A; background: #D30D3A;",
            _ => "border: 3px solid #039855; background: #039855"
        };
    }
}
