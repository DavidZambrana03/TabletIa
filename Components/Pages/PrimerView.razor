@page "/pages/PrimerView"
@inject ReadDTOService ReadDTO
@inject OpcUaClient opcUaClient
@inject IJSRuntime JS
@using Serilog
@using WhiteFlexo

<style>
    .torque-group-container {
        display: flex;
        flex-direction: column;
        width: fit-content;
        min-width: 80px;
    }
    .align-right {
        align-items: flex-end; 
    }

    .value-display {
        width: 100%;
        margin-bottom: 2px;
    }

    .torque-bar-container {
        width: 100%;
        height: 8px;
        background-color: #E0E0E0;
        border-radius: 3px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05); 
    }

    .torque-fill {
        height: 100%;
        transition: width 0.4s ease;
    }

    .module_big {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background: white;
        width: 100%;
        height: 100%;
        border-radius: 8px;
        transition: transform 1s ease;
    }
    .pressure-warning-box {
        margin-top: 15px;
        padding: 10px;
        background-color: rgba(255, 59, 48, 0.1);
        border: 2px solid #FF3B30;
        border-radius: 8px;
        color: #FF3B30;
        font-weight: bold;
        text-align: center;
        animation: blink-shadow-animation 2s infinite;
    }
    @@keyframes blink-shadow-animation {
        0%
    {
        opacity: 1;
        border-color: #FF3B30;
    }

    50% {
        opacity: 0.5;
        border-color: transparent;
    }

    100% {
        opacity: 1;
        border-color: #FF3B30;
    }
    }

    .back-button {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 24px;
        top: 20px;
        left: 20px;
    }

    .section_header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        gap: 10px;
        width: 100%;
        height: 39px;
        color: white;
        backdrop-filter: blur(6px);
        border-radius: 4px 4px 0px 0px;
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;
    }

    .container {
        width: 100%;
        padding: 0px;
    }

    .status-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .toggle-switch {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .switch {
        width: 50px;
        height: 28px;
        background-color: #ccc;
        border-radius: 999px;
        position: relative;
        transition: background-color 0.3s ease;
        margin-right: 10px;
    }

        .switch::before {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 24px;
            height: 24px;
            background-color: white;
            border-radius: 50%;
            transition: transform 0.3s ease;
        }

        .switch.enabled {
            background-color: #000;
        }

            .switch.enabled::before {
                transform: translateX(22px);
            }

    .status {
        height: 23px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #141414;
        flex: none;
        order: 1;
        flex-grow: 0;
    }

    .status-text {
        color: white;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
    }

    input.form-control {
        width: 60%;
        height: 40px;
        padding: 8px;
        margin-bottom: 5px;
        border-radius: 4px;
        border: 1px solid #ccc;
    }

    .error-message {
        color: red;
        font-size: 12px;
    }

    .button-group button {
        margin-right: 10px;
    }

    .side-by-side {
        display: flex;
        justify-content: space-between;
        gap: 10px; /* Space between the fields */
        padding: 0px;
        width: 100%;
    }

        .side-by-side .form-group {
            flex: 1; /* Distribute space equally between form groups */
        }

            .side-by-side .form-group label {
                width: 100%;
            }

    .padding_section {
        padding: 20px;
        justify-content: center;
    }

    .toggle-buttons {
        display: flex;
        justify-content: center; /* Aligns buttons to the left */
        gap: 10px; /* Adds spacing between buttons */
        padding: 10px; /* Adds some spacing around */
    }

        .toggle-buttons button {
            padding: 10px 20px;
            font-size: 1.2em;
            border: none; /* Remove border */
            background: none; /* Remove background */
            color: black; /* Default text color */
            cursor: pointer;
            transition: border-bottom 0s, color 0.3s;
        }

            .toggle-buttons button.active {
                border-bottom: 3px solid black; /* Green underline when active */
                color: black; /* Optional: Change text color when active */
            }

    .left-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
        background: #F5F5F5;
        height: 100%; /* Takes 100% height of its grid cell in .main_view */
        border-radius: 15px;
        align-items: flex-start;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }

    .right-container {
        display: flex;
        flex-direction: column;
        gap: 60px;
        padding: 20px;
        background: #F5F5F5;
        border-radius: 15px;
        height: 100%; /* Takes 100% height of its grid cell in .main_view */
        align-items: center;
        justify-content: center;
        text-align: center;
        box-sizing: border-box;
        overflow: hidden;
    }

    .button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #FFFFFF;
        border: 2px solid #000000;
        border-radius: 8px;
        flex: none;
        order: 0;
        flex-grow: 0;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-size: 18px;
        line-height: 23px;
        color: #000000;
    }

        .button:active {
            background: #e0e0e0;
            transform: translateY(2px);
            box-shadow: inset 0px 2px 4px rgba(0, 0, 0, 0.2);
        }

    .navigation-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%; /* Ensures it spans the full width */
        gap: 20px; /* Adds space between sections */
    }

        .navigation-buttons.disabled {
            pointer-events: none; /* Disable pointer events */
            opacity: 0.5; /* Make it look disabled */
        }

    .start-button {
        box-sizing: border-box;
        display: flex;
        flex-direction: row;
        padding: 8px 12px;
        gap: 8px;
        width: 12vw;
        height: 5vh;
        background: #000000;
        border: 1px solid #000000;
        border-radius: 8px;
        color: white;
        flex: none;
        order: 2;
        flex-grow: 0;
    }

    .stop-button {
        width: 12vw;
        height: 5vh;
        background: #D30D3A;
        mix-blend-mode: normal;
        border-radius: 25px;
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-size: 20px;
        line-height: 25px;
        text-align: center;
        color: #FFFFFF;
    }

    .collapsible-section {
        background-color: #EFF8FF;
        border: 1px solid #1B81F0;
        border-radius: 10px;
        overflow: hidden;
        max-height: 50px; 
        transition: max-height 0.5s ease-in-out;
        width: 30vw;
    }

        .collapsible-section.open {
            max-height: 500px; 
        }

    .collapsible-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px;
        cursor: pointer;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .collapsible-content {
        padding: 0 15px 15px 15px;
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .settings-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .main_view {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100%;
        margin: 10px;
        gap: 10px;
    }

    .image-container {
        display: flex;
        padding: 10px;
        flex-direction: column;
        justify-content: center;
        gap: 15px;
        width: 100%;
    }

        .image-container.disabled {
            pointer-events: none;
            opacity: 0.5;
        }

            .image-container.disabled .value-display {
                color: #999;
                background-color: #e9e9e9;
            }

    .image-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        overflow: hidden;
        background: #F5F5F5;
        border-radius: 10px;
        padding: 8px;
    }

    img.selectable-image {
        flex-grow: 1;
        flex-shrink: 1;
        width: 300px;
        height: auto;
        transition: transform 0.5s ease, opacity 0.5s ease;
        cursor: pointer;
        display: block;
        opacity: 0.3;
        border-radius: 4px;
    }

        img.selectable-image:hover {
            opacity: 1;
            transform: scale(1.02);
        }

        img.selectable-image.selected {
            transform: scale(1.04);
            opacity: 1;
        }

    .value-display {
        font-size: 0.85em;
        color: #2c3e50;
        padding: 5px 8px;
        width: 90px;
        text-align: center;
        background-color: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        flex-shrink: 0;
    }

    .value-label {
        font-weight: 600;
        font-size: 0.9em;
        color: #34495e;
        margin-right: 4px;
    }

    .pressure-view {
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 0px;
        gap: 32px;
        width: 600px;
        height: 240px;
        border-radius: 20px;
        flex: none;
        order: 2;
        flex-grow: 1;
    }


    .tension_section {
        display: flex;
        flex-direction: column;
        padding: 0px;
        gap: 6px;
        width: 100px;
        height: 110px;
    }

        .tension_section h4 {
            width: 100px;
            height: 23px;
            font-family: 'Inter';
            font-style: normal;
            font-weight: 500;
            font-size: 18px;
            line-height: 23px;
            color: #424242;
            flex: none;
            order: 0;
            flex-grow: 0;
        }

        .tension_section ul {
            box-sizing: border-box;
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 10px 14px;
            gap: 8px;
            width: 100px;
            height: 52px;
            background: #FFFFFF;
            border: 1px solid #A3A3A3;
            border-radius: 8px;
            flex: none;
            order: 1;
            align-self: stretch;
            flex-grow: 0;
        }

    .config_parameter {
        display: flex;
        flex-direction: column;
        padding: 0px;
        gap: 6px;
        width: 250px;
        height: 110px;
        margin-bottom: 5px;
    }

        .config_parameter h4 {
            width: 250px;
            height: 23px;
            font-family: 'Inter';
            font-style: normal;
            font-weight: 500;
            font-size: 18px;
            line-height: 23px;
            color: #424242;
            flex: none;
            order: 0;
            flex-grow: 0;
        }

        .config_parameter ul {
            box-sizing: border-box;
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 10px 14px;
            gap: 8px;
            width: 250px;
            height: 52px;
            background: #FFFFFF;
            border: 1px solid #A3A3A3;
            border-radius: 8px;
            flex: none;
            order: 1;
            align-self: stretch;
            flex-grow: 0;
        }

    .border-fill {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0px 0px 40px;
        gap: 12px;
        width: 156px;
        height: 260px;
        flex: none;
        order: 1;
        align-self: stretch;
        flex-grow: 0;
    }

        .border-fill ul {
            width: fit-content;
            padding:  0;
            height: 23px;
            font-family: 'Inter';
            font-style: normal;
            font-weight: 500;
            font-size: 18px;
            line-height: 23px;
            text-align: center;
            margin: 0 auto;
            color: #000000;
            flex: none;
            order: 0;
            flex-grow: 0;
            z-index: 0;
        }

    .fill-container {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding: 0px;
        isolation: isolate;
        width: 90px;
        height: 174px;
        background: #E5E5E5;
        border: 1.38188px solid #000000;
        border-radius: 8px;
        flex: none;
        order: 0;
        flex-grow: 0;
        z-index: 0;
        overflow: hidden;
    }

    .config_parameters_container {
        display: grid;
        margin-top: 1.5rem;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px !important; 
        margin-bottom: -10px;
    }
    .waste-fill {
        background-color: #737373;
    }

    .water-fill {
        background-color: #6AB5EB;
    }

    .white-fill {
        background-color: #FFFAEB;
    }

    .fill {
        width: 100%;
    }

    .relative-container {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .header-with-icon {
        display: flex;
        flex-direction: row;
        align-items: center;
        width: 100%;
        height: 23px; 
        gap: 8px;
    }

    .header-with-icon h4 {
        width: auto !important; 
        margin: 0;
        flex: 0 0 auto; 
    }
    .icon-trigger {
        color: #b0b0b0;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }
    .icon-trigger:active, .icon-trigger:hover {
        color: #007bff;
    }
    .transparent-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 900;
        background: transparent; 
    }
    .popover-content {
        position: absolute;
        top: 35px; 
        right: auto; 
        left : 0px;
        width: 220px;
        background: #ffffff;
        padding: 12px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        z-index: 999; 
        border: 1px solid rgba(0,0,0,0.05);
        font-family: 'Inter';
        font-weight: 400;
        font-size: 14px;
        color: #333;
        line-height: 1.4;
        text-align: left;
        white-space: normal;
        animation: fadeIn 0.2s ease-out;
    }

    .popover-content::before {
        content: "";
        position: absolute;
        top: -6px;
        right: 140px;
        border-width: 0 6px 6px 6px;
        border-style: solid;
        border-color: transparent transparent #ffffff transparent;
    }

    .side-indicator {
        font-size: 13px; /* Un pelín más pequeño para que no recargue */
        color: #A3A3A3;
        font-weight: 400;
        display: block;
        width: 180px; /* El mismo ancho que tus botones */
        text-align: left; /* Alineación a la izquierda */
        margin-bottom: 2px;
        margin-top: -2px; /* Para pegarlo un poco más al h4 si queda mucho hueco */
    }

    .text-left-aligned {
        text-align: left !important; /* El !important asegura que gane al estilo centrado de config_parameter */
        width: 100%;
        padding-left: 2px; /* Para que alinee con el borde del botón blanco */
        display: block;
        margin-bottom: 2px !important;
    }

    }
</style>


<div class="module_big" style="@GetModuleStyle(PrimerStatus)">
    <div class="section_header" style="@GetStatusStyle(PrimerStatus)">
        <div class="status">
            <span class="status-text">Primer unit AMB CUIDADOO ESTA WIPPP!!!!!</span>
        </div>
        <div class="status">
            <span class="status-text">@GetSelfCleanState(ReadDTO.M2_PLC_TO_HMI_DTO.iPrimerApplicationState)</span>
            @if (IsFlexoCleanEnabled())
            {
                <span class="status-text"> - Time left: @ReadDTO.M5_PLC_TO_HMI_DTO.iCleanSequenceTimeLeft s</span>
            }
        </div>
    </div>
    <div class="toggle-buttons">
        <button class="round-buttons" @onclick="Close">
            <svg width="18" height="13" viewBox="0 0 13 8" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: rotate(90deg);">
                <path d="M1.90039 1.49988L6.90039 6.49988L11.9004 1.49988" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button class="@GetButtonClass("Primer")" @onclick='() => SelectMode("Primer")'>Primer</button>
        <button class="@GetButtonClass("Configuration")" @onclick='() => SelectMode("Configuration")'>Configuration</button>
   </div>

    <div style='display: @(selectedMode == "Primer" ? "flex" : "none")'>
        <div class="main_view">
            <div class="left-container">
                <div class="config_parameters_container">
                    <div class="config_parameter" >
                        <h4 class="text-left-aligned">Chill roll pressure</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rChillRollNipPressureSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rChillRollNipPressurePV) bar
                        </ul>
                    </div>

                    <div class="config_parameter">
                        <h4 class="text-left-aligned">Drying temperature</h4>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rProdTunnelTempSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rTunnelTempPV) ºC
                        </ul>
                    </div>
                    <div class="config_parameter">
                        <h4 class="text-left-aligned">Sleeve pressure</h4>
                        <span class="side-indicator">Transmission side</span>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rCoatingSleeveTransSidePressureSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rCoatingSleeveTransSidePressurePV) bar
                        </ul>
                    </div>

                    <div class="config_parameter">
                        <h4 class="text-left-aligned">Sleeve pressure</h4>
                        <span class="side-indicator">Operator side</span>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rCoatingSleeveOpSidePressureSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rCoatingSleeveOpSidePressurePV) bar
                        </ul>
                    </div>
                </div>

                <div style="text-align: center; width: 100%; margin: 0px 0px -30px 0px ">
                    <img src="resources/new-primer.png" style="width: 400px; display: inline-block;" />
                </div>
                <div class="config_parameters_container">
                    <div class="config_parameter">
                        <h4 class="text-left-aligned">Doctor blade pressure</h4>
                        <span class="side-indicator">Transmission side</span>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rDoctorBladeTransSidePressureSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rDoctorBladeTransSidePressurePV) bar
                        </ul>
                    </div>

                    <div class="config_parameter">
                        <h4 class="text-left-aligned">Doctor blade pressure</h4>
                        <span class="side-indicator">Operator side</span>
                        <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.rDoctorBladeOpSidePressureSP))">
                            @(ReadDTO.M2_PLC_TO_HMI_DTO.rDoctorBladeOpSidePressurePV) bar
                        </ul>
                    </div>
                </div>


            </div>
            <div class="right-container">
                <div class="navigation-buttons">
                    @* El texto cambia según el estado del PLC, igual que el DataTrigger de XAML *@
                    <button class="button @(ReadDTO.M2_PLC_TO_HMI_DTO.bSleeveChangeActive ? "active-sleeve" : "")"
                            @onclick="OnChangeSleeveClick"> Change sleeve
                    </button>
                </div>                <div class="navigation-buttons">
                    <button class="button" @onclick='() => OnStartCommand("Clean")'>Clean</button>
                    <button class="button" @onclick='() => OnStartCommand("Empty")'>Empty</button>
                    @if (ReadDTO.M2_PLC_TO_HMI_DTO.bPrimerStarted)
                    {
                        <button class="button start-button" @onclick='() => OnStartCommand("Stop")'>Stop</button>
                    }
                    else
                    {
                        <button class="button start-button" @onclick='() => OnStartCommand("Start")'>Start</button>
                    }
                </div>
                
              
                <div class="navigation-buttons">
                    <div class="border-fill">
                        <ul>Waste</ul>
                        <div class="fill-container">
                            <div class="fill waste-fill" style="height: @ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlWasteTank%;">
                            </div>
                        </div>
                        <ul>@ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlWasteTank %</ul>
                    </div>

                    <div class="border-fill">
                        <ul>Water</ul>
                        <div class="fill-container">
                            <div class="fill water-fill" style="height: @ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlWaterTank%;">
                            </div>
                        </div>
                        <ul>@ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlWaterTank %</ul>
                    </div>

                    <div class="border-fill">
                        <ul>Primer</ul>
                        <div class="fill-container">
                            <div class="fill white-fill" style="height: @ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlPrimerTank%;">
                            </div>
                        </div>
                        <ul>@ReadDTO.M2_PLC_TO_HMI_DTO.uiLvlPrimerTank %</ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div style='display: @(selectedMode == "Configuration" ? "block" : "none")'>
        <div class="config_parameters_container">
            <div class="config_parameter">
                <h4>Cleaning cycles</h4>
                <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.iCleaningCyclesSP))">
                    @(ReadDTO.M2_HMI_TO_PLC_DTO.iCleaningCyclesSP) u
                </ul>
            </div>

            <div class="config_parameter">
                <h4>Clean Recirculation Time</h4>
                <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.udiCleaningRecircTimeSP))">
                    @(ReadDTO.M2_HMI_TO_PLC_DTO.udiCleaningRecircTimeSP) s
                </ul>
            </div>

            <div class="config_parameter">
                <h4>Clean Filling Water Time</h4>
                <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.udiCleaningFillWaterTimeSP))">
                    @(ReadDTO.M2_HMI_TO_PLC_DTO.udiCleaningFillWaterTimeSP) s
                </ul>
            </div>

            <div class="config_parameter">
                <h4>Clean Empty Time</h4>
                <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.udiCleaningEmptyTimeSP))">
                    @(ReadDTO.M2_HMI_TO_PLC_DTO.udiCleaningEmptyTimeSP) s
                </ul>
            </div>

            <div class="config_parameter">
                <h4>Sleeve change Time</h4>
                <ul @onclick="() => ChangeParameter(nameof(M2_HMI_TO_PLC_DTO), nameof(M2_HMI_TO_PLC_DTO.udiSleeveChangeTimeSP))">
                    @(ReadDTO.M2_HMI_TO_PLC_DTO.udiSleeveChangeTimeSP) s
                </ul>
            </div>
        </div>
    </div>

    <PopupConfirmation @ref="popup" />
    @if (isEditing)
    {
        <div class="keypad-overlay" @onclick="CloseKeypad">
            <div @onclick:stopPropagation="true">
                <Keypad Value="@valueToChange" MinValue="@minValue" MaxValue="@maxValue" OnSave="SaveValue" OnCancel="CancelEdit" />
            </div>
        </div>
    }
</div>

@code {
    private bool isEditing = false;
    private bool isSettingsOpen = false;
    private bool showSmartPrintInfo = false;
    private float valueToChange;
    private float minValue = 0f;
    private float maxValue = 0.5f; // Adjust as needed
    private string? editingDto;
    private string? editingParameter;
    private bool editingOffsets;
    private bool LateralOffsetEdited;
    private bool OffsetEdited;
    Serilog.ILogger serilog = Serilog.Log.ForContext<WhiteFlexoView>();
    private PopupConfirmation? popup;

    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }


    private void ToggleSmartPrintInfo()
    {
        showSmartPrintInfo = !showSmartPrintInfo;
    }
    private void CloseSmartPrintInfo()
    {
        showSmartPrintInfo = false;
    }

    void OnChangeSleeveClick()
    {
        string tagPath = nameof(M2_HMI_TO_PLC_DTO) + "." + nameof(M2_HMI_TO_PLC_DTO.bSleeveChangeActivationPB);
        popup?.Show("Confirm Sleeve Change Action?", "Change Sleeve", tagPath);
    }
    void OnStartCommand(string command)
    {
        try
        {
            switch (command)
            {
                case "Clean":
                    popup?.Show("Start Cleaning Sequence", "Clean", nameof(M2_HMI_TO_PLC_DTO) + "." + nameof(M2_HMI_TO_PLC_DTO.bStartCleaningPB));
                    break;
                case "Empty":
                    popup?.Show("Drain Doctor Blade", "Drain", nameof(M2_HMI_TO_PLC_DTO) + "." + nameof(M2_HMI_TO_PLC_DTO.bDrainDoctorBladePB));
                    break;
                case "Start":
                    tryToStartRecirculation();
                    break;
                case "Stop":
                    popup?.Show("Stop Primer Recirculation", "Stop", nameof(M2_HMI_TO_PLC_DTO) + "." + nameof(M2_HMI_TO_PLC_DTO.bEnablePrimerSystem));
                    break;
                default:
                    serilog.Warning($"Unknown command: {command}");
                    break;
            }
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }
    void tryToStartRecirculation()
    {
        bool lowPressure = ReadDTO.M2_PLC_TO_HMI_DTO.rDoctorBladeOpSidePressurePV < 2 || ReadDTO.M2_PLC_TO_HMI_DTO.rDoctorBladeTransSidePressurePV < 2;
        string tagStart = nameof(M2_HMI_TO_PLC_DTO) + "." + nameof(M2_HMI_TO_PLC_DTO.bEnablePrimerSystem);

        if (lowPressure)
        {
            popup?.Show(
                "Pressure is TOO LOW. Risk of primer leakage. Are you sure?",
                "Start",
                tagStart
            );
        }
        else
        {
            popup?.Show("Start primer Recirculation", "Start", tagStart);
        }
        // if ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureCs || ReadDTO.M5_PLC_TO_HMI_DTO.rDrBladePressureMs are above 0.5, show warning saying "Doctor blade pressure is above 0.5 bar. Are you sure you want to start recirculation?" with options "Yes, start recirculation" and "No, cancel". If user selects "Yes, start recirculation", start recirculation, if user selects "No, cancel", do nothing.
        //popup?.Show("Start Flexo Recirculation", "Start", nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartProductRecirculation));
    }
    void SetPosition(int type)
    {
        var posString = GetStringType(type);
        if (string.IsNullOrEmpty(posString)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + posString, true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }
  
    string GetPosType(int type)
    {
        switch (type)
        {
            case 0: return "Emergency";
            case 1: return "Stop";
            case 2: return "Primer Recirculation";
            case 3: return "Filling Water";
            case 4: return "Clean Recirculation";
            case 5: return "Emptying";
            case 6: return "Sleeve Extraction";
            default: return "Unknown";
        }
    }
    string GetSelfCleanState(int type)
    {
        switch (type)
        {
            case 0: return "Emergency";
            case 1: return "Stop";
            case 2: return "Product Recirculation";
            case 3: return "Filling Water";
            case 4: return "Clean Recirculation";
            case 5: return "Emptying";
            case 6: return "Sleeve extraction";
            case 7: return "Emptying product";
            case 8: return "Slow Rotation";
            default: return "Unknown";
        }
    }

    bool IsFlexoCleanEnabled()
    {
        return ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState >= 3 &&
               ReadDTO.M5_PLC_TO_HMI_DTO.iFlexoSelfCleanState <= 5;
    }


    void SetPlateCylinderOffset()
    {
        opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderPrintingOffset), true);
    }
    void SetPlateCylinderOffsets()
    {
        if (OffsetEdited)
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderPrintingOffset), true);
            OffsetEdited = false;
        }
        if (LateralOffsetEdited)
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderLateralPrintingOffset), true);
            LateralOffsetEdited = false;
        }
    }
    void SetPlateCylinderLateralOffset()
    {
        opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bSetPlateCylinderLateralPrintingOffset), true);
    }

    void GoToMovements(int type)
    {

        var posString = GetStringMovement(type);
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + posString, true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }
    private int GetTorqueBar(float torque)
    {
        if (!opcUaClient.IsConnected)
        {
            return 50;
        }
        else
        {
            int percent = (int)torque ;
            return percent;
        }
    }

    private string GetTorqueColor(float torque)
    {
        if (!opcUaClient.IsConnected)
        {
            return "#4CD964";
        }
        else
        {
            return torque switch
            {
                > 80 => "#FF3B30", // Rojo: Crítico, motor sufriendo
                > 50 => "#FFCC00", // Amarillo/Naranja: Esfuerzo elevado
                _ => "#4CD964"  // Verde: Todo OK, movimiento fluido
            };
        }
    }
    private string GetStringMovement(int type)
    {
        switch (type)
        {
            case 1: return nameof(M5_HMI_TO_PLC_DTO.bGoToHome);
            case 2: return nameof(M5_HMI_TO_PLC_DTO.bStopMove);
            case 3: return nameof(M5_HMI_TO_PLC_DTO.bGoToPrint);
            case 4: return nameof(M5_HMI_TO_PLC_DTO.bStartRecirculation);
            case 5: return nameof(M5_HMI_TO_PLC_DTO.bSleeveChangeMovement);
            case 6: return nameof(M5_HMI_TO_PLC_DTO.bStopRecirculation);
            default: return nameof(M5_HMI_TO_PLC_DTO.bStopMove);
        }
    }

    private void ToggleEnabled()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bManualAdjust), !ReadDTO.M5_PLC_TO_HMI_DTO.bIsManualAdjust);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }
    private void ToggleEnabledSmartPrint()
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bEnableSmartPrint), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC: {ex.Message}");
        }
    }


    void ChangeParameter(string dto, string parameter)
    {
        editingDto = dto;
        editingParameter = parameter;

        object param = opcUaClient.ReadFromPlc($"{dto}.{parameter}");

        if (float.TryParse(param?.ToString(), out float parsedVal))
        {
            valueToChange = parsedVal;
        }
        else
        {
            valueToChange = 0f;
        }
        SetMinMax(dto, parameter);
        isEditing = true;
        if (parameter == "rPlateCylinderPrintingOffset" || parameter == "rPlateCylinderPrintingOffset")
        {
            editingOffsets = true;
        }
        if (parameter == "rMarkSensorPositionSetpoint")
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bStartMarkSensor), true);
        }

    }
    private void SetMinMax(string dto, string paramName)
    {
        minValue = 0.0f; // Default min value
        maxValue = 100.0f; // Default max value
        switch (dto)
        {
            case nameof(M0_HMI_TO_PLC_DTO):
                ReadDTO.M0_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M1_HMI_TO_PLC_DTO):
                ReadDTO.M1_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M2_HMI_TO_PLC_DTO):
                ReadDTO.M2_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M4_HMI_TO_PLC_DTO):
                ReadDTO.M4_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, ref minValue, ref maxValue);
                break;
            case nameof(M5_HMI_TO_PLC_DTO):
                ReadDTO.M5_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            case nameof(M7_HMI_TO_PLC_DTO):
                ReadDTO.M7_HMI_TO_PLC_DTO.SetMinMaxValues(paramName, out minValue, out maxValue);
                break;
            default:
                break;
        }
    }
    private void CancelEdit()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void CloseKeypad()
    {
        isEditing = false;
        StateHasChanged();
    }

    private void SaveValue(object value)
    {
        if (editingDto != null && editingParameter != null)
        {
            opcUaClient.WriteToPlc(editingDto + "." + editingParameter, value);
            if (editingParameter.Equals(nameof(M5_HMI_TO_PLC_DTO.rDrBladePressureCs)))
            {
                opcUaClient.WriteToPlc(editingDto + "." + nameof(M5_HMI_TO_PLC_DTO.rDrBladePressureMs), value);
            }
        }
        isEditing = false;
        if (editingOffsets)
        {
            object param = opcUaClient.ReadFromPlc(editingDto + "." + editingParameter);
            if (param != value)
            {
                if (editingParameter.Equals("rPlateCylinderPrintingLateralOffset"))
                {
                    LateralOffsetEdited = true;
                }
                else if (editingParameter.Equals("rPlateCylinderPrintingOffset"))
                {
                    OffsetEdited = true;
                }
            }
        };
    }

    string GetStringType(int type)
    {
        switch (type)
        {
            case 1: return nameof(M5_HMI_TO_PLC_DTO.bSetHomePosition);
            case 2: return nameof(M5_HMI_TO_PLC_DTO.bSetPrintPosition);
            case 3: return "bSetZeroPosition";
            case 4: return nameof(M5_HMI_TO_PLC_DTO.bSetDeckCenterPosition);
            default: return string.Empty;
        }
    }

    void SelectImage(string imageName)
    {
        opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + nameof(M5_HMI_TO_PLC_DTO.bAxPcSelector), imageName == "bottom");
    }

    private void HandleJogPress(string direction)
    {
        string plcTag = MovementDTOName(direction);
        if (string.IsNullOrEmpty(plcTag)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + plcTag, true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC on jog press ({direction}): {ex.Message}");
        }

    }

    private void HandleJogRelease(string direction)
    {
        string plcTag = MovementDTOName(direction);
        if (string.IsNullOrEmpty(plcTag)) return;
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + plcTag, false);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC on jog release ({direction}): {ex.Message}");
        }
    }

    void MovingOperation(string movementDirection)
    {
        try
        {
            opcUaClient.WriteToPlc(nameof(M5_HMI_TO_PLC_DTO) + "." + MovementDTOName(movementDirection), true);
        }
        catch (Exception ex)
        {
            serilog.Error($"Error writing to PLC in MovingOperation ({movementDirection}): {ex.Message}");
        }
    }

    string MovementDTOName(string movement)
    {
        switch (movement)
        {
            case "UpMS": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd_MS);
            case "DownMS": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev_MS);
            case "UpCS": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd_CS);
            case "DownCS": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev_CS);
            case "Up": return nameof(M5_HMI_TO_PLC_DTO.bMoveFwd);
            case "Down": return nameof(M5_HMI_TO_PLC_DTO.bMoveRev);
            case "MS": return nameof(M5_HMI_TO_PLC_DTO.bDeckMoveTo_MS);
            case "CS": return nameof(M5_HMI_TO_PLC_DTO.bDeckMoveTo_CS);
            case "WINDOW": return nameof(M5_HMI_TO_PLC_DTO.bFlexoMarkSensorWindowPb);
            case "TEACH": return nameof(M5_HMI_TO_PLC_DTO.bFlexoMarkSensorTeach);
            default: return string.Empty;
        }
    }

    string GetImageClass(string imageName)
    {
        bool isAxialSelected = ReadDTO.M5_PLC_TO_HMI_DTO.bAxPcSelector;
        if (imageName == "bottom")
        {
            return isAxialSelected ? "selectable-image selected" : "selectable-image";
        }
        else
        {
            return !isAxialSelected ? "selectable-image selected" : "selectable-image";
        }
    }

    private string selectedMode = "Primer";

    private void SelectMode(string mode)
    {
        selectedMode = mode;
    }
    bool IsUserExpert()
    {
        return ReadDTO.M0_HMI_TO_PLC_DTO.iUserLevel == 3 ||
               ReadDTO.M0_HMI_TO_PLC_DTO.iUserLevel == 4;
    }
    private string GetButtonClass(string mode)
    {
        return selectedMode == mode ? "active" : "";
    }

    private string PrimerStatus => GetPosType(ReadDTO.M2_PLC_TO_HMI_DTO.iPrimerApplicationState);

    [Parameter] public string Module { get; set; } = "White flexo";

    private string GetModuleStyle(string status)
    {
        return status switch
        {
            "Ready" or "Primer Recirculation" or "Home" or "Filling Water" or "Sleeve Extraction" => "border: 3px solid #039855;",
            "Stop" => "border: 3px solid #DC6803;",
            "EmergencyStop" or "Emergency" => "border: 3px solid #D30D3A; background: #ffcccc;",
            _ => "border: 3px solid #6B7280;"
        };
    }

    private string GetStatusStyle(string status)
    {
        return status switch
        {
            "Ready" or "Print" or "Home" or "Stand By" or "Pre Print" or "Primer Recirculation"=> "border: 3px solid #039855; background: #039855",
            "Stop" => "border: 3px solid #DC6803; background: #DC6803",
            "Emergency" => "border: 3px solid #D30D3A; background: #D30D3A;",
            _ => "border: 3px solid #6B7280; background: #6B7280"
        };
    }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
    private bool isExpanded = false;

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
    }
}
